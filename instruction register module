module IR (
  input CLK,
  input CLR_n,
  input Ei_n,
  input Li_n,
  input [7:0] bus,
  output [3:0] opcode,
  output [3:0] address,
  output hlt
);
  
  reg [7:0] instruction;
  reg [3:0] ad;
  
  always@ (posedge CLK) begin
    if(negedge Li_n) begin
      instruction <= bus;
    end
    
    assign opcode = introduction [7:4];
    assign ad = instruction [3:0]];
    
    assign address = Ei_n ? 3'bz : ad;
  
    always@ (*) begin
      if (opcode == 4'b1111) begin
        hlt = 1;
      end else begin
        hlt = 0;
      end
    end
    
endmodule

module ProgramCounter (
  input CLK,
  input CLR_n,
  input Cp,
  input Ep,
  output [3:0] address
);
  
  reg [3:0] ad;
  
  always @ (negedge CLR_n, posedge CLK) begin
    
    if (negedge CLR_n) begin
      ad <= b'0000;
    end
    
    else if (Cp) begin
      ad <= ad +1;
    end
    
   assign out = Ep ? ad : 3'bz;
    
  end
  
endmodule
